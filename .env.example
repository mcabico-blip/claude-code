# ── API ──────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES=8h
# Field roles get a long offline grace; sensitive roles short sessions.
JWT_EXPIRES_FIELD=72h

# ── Stateful endpoints — EXTERNALIZED FROM LINE ONE (hard rule 6) ────
# Co-located on one box today, but always addressed as endpoints so the
# stack splits later via config, not code.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ubi
DB_PASS=ubi_dev
DB_NAME=ubi_suite
# Dev convenience only — use migrations before production.
DB_SYNC=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Storage (hard rule 3: binaries never in Postgres) ────────────────
# Swappable driver: local now → drive/s3/hci later, no rewrite.
STORAGE_DRIVER=local
STORAGE_ROOT=./uploads

# ── Sign in with Google (optional, layered on standalone auth) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── External systems (integration stubs) ─────────────────────────────
ACUMATICA_BASE_URL=
OAEC_BASE_URL=
